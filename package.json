{
  "name": "neatnote",
  "version": "1.4.0",
  "description": "A scratchpad that stays organized: a local-first note-taking app",
  "main": "src/main/main.js",
  "homepage": "https://theneatnote.com",
  "author": {
    "name": "NeatNote",
    "email": "theneatnoteapp@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "electron tests/e2e/run.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.neatnote.app",
    "productName": "NeatNote",
    "copyright": "Copyright \u00a9 NeatNote",
    "files": [
      "src/**/*",
      "assets/**/*",
      "vendor/**/*",
      "index.html"
    ],
    "asar": true,
    "publish": null,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "NeatNote-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "synopsis": "A scratchpad that stays organized",
      "maintainer": "NeatNote <theneatnoteapp@gmail.com>",
      "icon": "build/icon.png",
      "artifactName": "NeatNote-${version}-${arch}.${ext}",
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NeatNote",
      "uninstallDisplayName": "NeatNote",
      "artifactName": "NeatNote-Setup-${version}.${ext}",
      "include": "installer/win/custom-installer.nsh"
    }
  },
  "desktopName": "neatnote.desktop"
}
